[resource]
default_font_size = 16
PanelContainer/styles/panel = SubResource("SBF_panel")
Button/styles/normal = SubResource("SBF_btn_normal")
Button/styles/hover = SubResource("SBF_btn_hover")
Button/styles/pressed = SubResource("SBF_btn_pressed")
Button/styles/disabled = SubResource("SBF_btn_disabled")
Button/styles/focus = SubResource("SBF_btn_focus")
Button/colors/font_color = Color(0.9412, 0.9412, 0.9569, 1)
Button/colors/font_hover_color = Color(0.9412, 0.9412, 0.9569, 1)
Button/colors/font_pressed_color = Color(0.9412, 0.9412, 0.9569, 1)
Button/colors/font_disabled_color = Color(0.549, 0.549, 0.6, 1)
Button/font_sizes/font_size = 16
Label/colors/font_color = Color(0.9412, 0.9412, 0.9569, 1)
Label/font_sizes/font_size = 16
ProgressBar/styles/fill = SubResource("SBF_pb_fill")
ProgressBar/styles/background = SubResource("SBF_pb_bg")
