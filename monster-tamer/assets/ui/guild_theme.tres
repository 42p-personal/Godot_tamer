[gd_resource type="Theme" load_steps=9 format=3]

; Guild Colours — hand-authored .tres mirror of UiTheme.base_theme() (scripts/ui/theme.gd).
; Values here MUST match theme.gd's PALETTE section exactly — if you touch one, touch both.
; Use this when a screen prefers assigning a Theme resource via the Inspector instead of calling
; UiTheme.base_theme() from code; either path produces the same look. See docs/UI_THEME.md.
;
; ⚠️ Hand-authored, not exported from a running editor session (no Godot execution was available
; when this file was written) — open it once in the editor and confirm it loads without error
; before relying on it in a shipped scene.

[sub_resource type="StyleBoxFlat" id="SBF_panel"]
bg_color = Color(0.1098, 0.1098, 0.1412, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.2, 0.2, 0.2392, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0

